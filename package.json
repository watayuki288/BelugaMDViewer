{
  "name": "beluga-md-viewer",
  "version": "1.0.2",
  "description": "Standalone Windows Markdown viewer & rich WYSIWYG editor",
  "author": "BelugaMDViewer Contributors",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "dist:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:dir": "electron-vite build && electron-builder --win --x64 --dir --publish never"
  },
  "dependencies": {
    "mime-types": "3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-code": "3.31.3",
    "@tiptap/extension-code-block": "3.31.3",
    "@tiptap/extension-code-block-lowlight": "3.31.3",
    "@tiptap/extension-details": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-mathematics": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.2.6",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^3.1.0",
    "github-slugger": "2.0.0",
    "highlight.js": "11.11.1",
    "katex": "0.18.10",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.511.0",
    "marked": "^17.0.1",
    "mermaid": "11.17.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-cjk-friendly": "^2.3.4",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.3",
    "unified": "^11.0.5",
    "vite": "^6.3.5"
  },
  "pnpm": {
    "overrides": {
      "katex": "0.18.10",
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
    },
    "patchedDependencies": {
      "@tiptap/markdown@3.31.3": "patches/@tiptap__markdown@3.31.3.patch",
      "mermaid@11.17.2": "patches/mermaid@11.17.2.patch"
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
